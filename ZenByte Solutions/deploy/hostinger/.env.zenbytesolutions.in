# Production deployment for zenbytesolutions.in
# Copy to project root: cp deploy/hostinger/.env.zenbytesolutions.in .env

DOMAIN=zenbytesolutions.in

# MySQL — change these before deploying
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
MYSQL_DATABASE=zenbyte_db
MYSQL_USER=zenbyte
MYSQL_PASSWORD=CHANGE_ME_db_password

SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/zenbyte_db
SPRING_DATASOURCE_USERNAME=zenbyte
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_db_password
JWT_SECRET=CHANGE_ME_long_random_jwt_secret_at_least_32_chars
SPRING_PROFILES_ACTIVE=prod
JAVA_OPTS=-Xmx512m -Xms256m
