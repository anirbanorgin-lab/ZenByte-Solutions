# Environment Variables Template for ZenByte Solutions

## Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=zenbyte_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

## Server Configuration
SERVER_PORT=8080
SERVER_CONTEXT_PATH=/api

## JWT Configuration
JWT_SECRET=your_very_secure_jwt_secret_key_change_this_in_production_environment
JWT_EXPIRATION=86400000

## CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_MAX_AGE=3600

## Email Configuration (Optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@zenbytesolutions.com

## File Upload Configuration
MAX_FILE_SIZE=10MB
UPLOAD_DIR=/uploads

## Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

## Application Configuration
APP_ENV=development
APP_NAME=ZenByte Solutions
APP_VERSION=1.0.0

## AWS Configuration (Optional for Cloud Deployment)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=zenbyte-solutions-bucket

## Google Cloud Configuration (Optional)
GOOGLE_PROJECT_ID=your-project-id
GOOGLE_STORAGE_BUCKET=your-storage-bucket
